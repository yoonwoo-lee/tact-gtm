# Copy this file to .env.local and fill in what you have.
# Every line is optional: a missing key switches that one part to sample data.
# Check them all with:  npm run doctor

NEXT_PUBLIC_APP_NAME=Connet

# The model (Google AI Studio key). Models are tried in the order given in GEMINI_MODELS.
GEMINI_API_KEY=
# GEMINI_MODELS=gemini-3.8-flash,gemini-flash-latest,gemini-3.5-flash-lite,gemini-flash-lite-latest

# Web search with source text (tavily.com)
TAVILY_API_KEY=

# Business email lookup (hunter.io). The free plan allows 25 domain searches a month.
HUNTER_API_KEY=

# Knowledge graph (Neo4j Aura free instance: console.neo4j.io)
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# Usage billing (flexprice.io). Use the API host for the region your account is in.
FLEXPRICE_API_KEY=
FLEXPRICE_API_HOST=https://us.api.flexprice.io/v1
FLEXPRICE_CUSTOMER_ID=tact-demo

# Optional: mirror the agents' conversation into a Band room (band.ai).
# Easiest: put a user key here (Band: Settings, API Keys) and run `npm run setup:band`.
# It registers the four agents, makes the room and fills in the five lines below.
BAND_USER_API_KEY=
# One key per agent, or a single BAND_API_KEY used for all four.
BAND_CHAT_ID=
BAND_API_KEY_PLANNER=
BAND_API_KEY_BUILDER=
BAND_API_KEY_REVIEWER=
BAND_API_KEY_SECURITY=

# Optional: mirror each deal room into a Teamily conversation (teamily.ai).
# In Teamily: your agent -> Agent workspace -> Agent API -> Setup -> RESTful API for servers.
# Turn it on, Generate Key (shown once), and the agent id is on the same card.
TEAMILY_AGENT_TOKEN=
TEAMILY_AGENT_ID=
TEAMILY_API_HOST=https://teamily.ai/v1

# Optional: let an outside agent work the deal rooms through /api/mcp.
# Any long random string of your own. Unset, that endpoint is off and answers 404.
# Reaching it from Teamily needs a public URL:  ngrok http 3000
CONNET_MCP_TOKEN=

# Demo settings
# TACT_SAMPLE=1            # force sample data everywhere (no network at all)
# TACT_CACHE=0             # do not save or reuse answers from live services (default: saved for 72 hours)
# TACT_CACHE_HOURS=72      # how long a saved answer is reused; `npm run fresh` deletes them all
# LLM_CONCURRENCY=3        # model calls in flight at once; use 1 on a free Gemini key
# TACT_START_CREDITS=30    # credits a fresh workspace starts with
# TACT_MAX_COMPANIES=10
# TACT_MAX_DRAFTS=3        # how many of the best leads the agent drafts for on its own
